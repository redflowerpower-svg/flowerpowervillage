{
  "functions": {
    "api/[...route].ts": {
      "includeFiles": "public/FP_04_-_LOGO_OFFICIAL_HD.png"
    }
  },
  "crons": [
    {
      "path": "/api/resort-sentinel",
      "schedule": "0 1 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/flowerpowerpizzaranong",
      "destination": "https://www.flowerpowerpizza.com",
      "permanent": true
    },
    {
      "source": "/flowerpowerpizzaranong/:path*",
      "destination": "https://www.flowerpowerpizza.com",
      "permanent": true
    },
    {
      "source": "/flowerpowerpizza",
      "destination": "https://www.flowerpowerpizza.com",
      "permanent": true
    },
    {
      "source": "/flowerpowerpizza/:path*",
      "destination": "https://www.flowerpowerpizza.com",
      "permanent": true
    },
    {
      "source": "/36-room-6",
      "destination": "/village",
      "permanent": true
    },
    {
      "source": "/36-room-6/:path*",
      "destination": "/village",
      "permanent": true
    },
    {
      "source": "/room-6",
      "destination": "/village",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "(?:www\\.)?flowerpowerpizza\\.com"
        }
      ],
      "destination": "/sitemap-pizza.xml"
    },
    {
      "source": "/llms.txt",
      "has": [
        {
          "type": "host",
          "value": "(?:www\\.)?flowerpowerpizza\\.com"
        }
      ],
      "destination": "/llms-pizza.txt"
    },
    {
      "source": "/api-octorate/:path*",
      "destination": "https://api.octorate.com/:path*"
    },
    {
      "source": "/api/webhooks/octorate",
      "destination": "/api/octorate-webhook"
    },
    {
      "source": "/api/webhooks/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/api/resort/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/dining",
      "destination": "/dining.html"
    },
    {
      "source": "/dining/:path*",
      "destination": "/dining.html"
    },
    {
      "source": "/tavoli",
      "destination": "/dining.html"
    },
    {
      "source": "/tavoli/:path*",
      "destination": "/dining.html"
    },
    {
      "source": "/kitchen",
      "destination": "/kitchen.html"
    },
    {
      "source": "/kitchen/:path*",
      "destination": "/kitchen.html"
    },
    {
      "source": "/kds",
      "destination": "/kitchen.html"
    },
    {
      "source": "/kds/:path*",
      "destination": "/kitchen.html"
    },
    {
      "source": "/((?!api/|api-octorate/|@|src/|node_modules/|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
