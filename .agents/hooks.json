{
  "antigravity-secret-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "read_file|view_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ../scripts/antigravity-secret-guard.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
